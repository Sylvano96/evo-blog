# Copy this file to `.env` (next to docker-compose.yml) and fill in the values.
# `.env` is git-ignored: never commit it.

# ---- Database ----
DB_NAME=evoblog
DB_USERNAME=evoblog
DB_PASSWORD=change-me

# ---- Security ----
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# First admin account, created at startup (password: at least 12 characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---- Mail ----
# false = activation codes are printed in the API logs:  docker compose logs api
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Web ----
WEB_PORT=4000
PUBLIC_URL=http://localhost:4000
